          <div><h2 class="tv-bar">대표 작업</h2></div>
        </div>

        <div class="slider-nav">
          <div class="slider-tabs">
            {works.map((w, i) => (
              <button type="button" class={`slider-tab ${i === 0 ? "is-active" : ""}`} data-slide={i}>
                <span class="slider-tab-num">0{i + 1}</span>
                <span class="slider-tab-title">{w.tab}</span>
              </button>
            ))}
          </div>
          <div class="slider-arrows">
            <button type="button" class="slider-arrow" id="slider-prev" aria-label="이전 작업"><Fragment set:html={chevL} /></button>
            <button type="button" class="slider-arrow" id="slider-next" aria-label="다음 작업"><Fragment set:html={chevR} /></button>
          </div>
        </div>

        <div class="feature-slider-outer">
          {works.map((w, i) => (
            <div class={`feature-slide ${i === 0 ? "is-active" : ""}`} data-index={i}>
              <div class="feature-copy">
                <p class="feature-label">{w.label}</p>
                <h3 class="tv-lines">{w.title}</h3>
                <p class="tv-lines">{w.summary}</p>
                <p class="feature-status tv-lines">{w.status}</p>
                <div class="evidence-grid">
                  <div class="compact-list">
                    <span>수행한 역할</span>
                    <ul>{w.role.map((r) => <li>{r}</li>)}</ul>
                  </div>
                  <div class="compact-list">
                    <span>주요 성과</span>
                    <ul>{w.result.map((r) => <li>{r}</li>)}</ul>
                  </div>
                </div>
                <div class="tag-row">{w.tags.map((t) => <span>{t}</span>)}</div>
                {w.link && (
                  <a href={w.link.href} target="_blank" rel="noreferrer" class="inline-link tv-inline-link">{w.link.label}</a>
                )}
              </div>

              <div class="feature-media-column">
                <div class="media-slider" data-media-slider>
                  {w.media.map((m, j) => (
                    <div class={`media-slide ${j === 0 ? "is-active" : ""}`}>
                      {m.kind === "file" ? (
                        <div class="video-card">
                          <div class="video-head">
                            <span>{m.title}{m.note && <em class="tv-note"> · {m.note}</em>}</span>
                          </div>
                          <video class="tv-slide-video" src={m.src} controls playsinline preload="metadata"></video>
                        </div>
                      ) : m.kind === "image" ? (
                        <figure class="diagram-card tv-zoomable" data-zoom-src={m.src} data-zoom-caption={m.caption} tabindex="0" role="button" aria-label={`${m.caption} 크게 보기`}>
                          <img src={m.src} alt={m.caption} loading="lazy" />
                          <span class="tv-zoom-hint">클릭해서 크게 보기</span>
                          <figcaption class="diagram-caption">{m.caption}</figcaption>
                        </figure>
                      ) : (
                        <div class="video-card">
                          <div class="video-head">
                            <span>{m.title}{m.note && <em class="tv-note"> · {m.note}</em>}</span>
                            <a href={m.kind === "yt" ? ytWatch(m.id) : driveView(m.id)} target="_blank" rel="noreferrer" class="yt-link">
                              {m.kind === "yt" ? "YouTube에서 보기" : "원본 보기"}
                            </a>
                          </div>
                          <iframe
                            class={`portfolio-video ${m.kind === "drive" ? "is-drive" : ""}`}
                            src={i === 0 && j === 0 ? ytEmbed(m.id) : undefined}
                            data-src={m.kind === "yt" ? ytEmbed(m.id) : driveEmbed(m.id)}
                            title={m.title}
                            frameborder="0"
                            loading="lazy"
                            allow="encrypted-media; picture-in-picture"
                            allowfullscreen
                          ></iframe>
                        </div>
                      )}
                    </div>
                  ))}
                  {w.media.length > 1 && (
                    <div class="media-nav">
                      <button type="button" class="media-arrow media-prev" aria-label="이전"><Fragment set:html={mChevL} /></button>
                      <span class="media-dots">1 / {w.media.length}</span>
                      <button type="button" class="media-arrow media-next" aria-label="다음"><Fragment set:html={mChevR} /></button>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 툴 활용 -->
      <section id="tools" class="content-section">
        <div class="section-header">
          <div><h2 class="tv-bar">툴 활용</h2></div>
        </div>

        <div class="management-grid">
          <div class="management-panel">
            {toolStories.map((s) => (
              <article class="metric-card">
                <p>{s.label}</p>
                <strong>{s.title}</strong>
                <span class="tv-lines">{s.body}</span>
              </article>
            ))}
          </div>
          <div class="management-panel">
            <p class="panel-label">영상·이미지 생성</p>
            <div class="tool-cloud">{genTools.map((t) => <span>{t}</span>)}</div>
            <p class="panel-label second-label">편집·개발</p>
            <div class="skill-cloud">{makeTools.map((t) => <span>{t}</span>)}</div>
          </div>
        </div>
      </section>

      <!-- 기타 작업 -->
      <section id="more" class="content-section">
        <div class="section-header">
          <div><h2 class="tv-bar">기타 작업</h2></div>
        </div>

        <div class="archive-shell">
          <div class="archive-tab-row" role="tablist" aria-label="기타 작업 탭">
            {moreTabs.map((tab, i) => (
              <button type="button" class={`archive-tab ${i === 0 ? "is-active" : ""}`} data-archive-tab={tab.id} aria-selected={i === 0 ? "true" : "false"}>
                {tab.label}
              </button>
            ))}
          </div>
          <div class="archive-panel-wrap">
            {moreTabs.map((tab, i) => (
              <section class={`archive-panel ${i === 0 ? "is-active" : ""}`} data-archive-panel={tab.id} hidden={i !== 0}>
                <div class="archive-grid">
                  {tab.items.map((c) => (
                    <article class="archive-card">
                      <p class="archive-card-label">{c.label}</p>
                      <h3>{c.title}</h3>
                      {c.ytId ? (
                        <div class="tv-card-media">
                          <iframe src={ytEmbed(c.ytId)} title={c.title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
                        </div>
                      ) : c.driveId ? (
                        <div class="tv-card-media is-drive">
                          <iframe src={driveEmbed(c.driveId)} title={c.title} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
                        </div>
                      ) : c.video ? (
                        <div class="tv-card-media">
                          <video src={c.video} controls playsinline preload="metadata"></video>
                        </div>
                      ) : c.image ? (
                        <div class="tv-card-media"><img src={c.image} alt={c.title} loading="lazy" /></div>
                      ) : null}
                      <p>{c.body}</p>
                      <div class="tag-row">{c.tags.map((t) => <span>{t}</span>)}</div>
                      {c.link && <a href={c.link.href} target="_blank" rel="noreferrer" class="inline-link">{c.link.label}</a>}
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </section>
    </main>

    <div class="tv-lightbox" id="tv-lightbox" hidden>
      <button type="button" class="tv-lightbox-close" aria-label="닫기">닫기</button>
      <figure>
        <img alt="" />
        <figcaption></figcaption>
      </figure>
    </div>

    <footer class="tv-footer">
      <p class="tv-footer-name">서정윤 · Seo Jungyoun</p>
      <p class="tv-footer-sub">AI Content Builder</p>
      <div class="tv-footer-links">
        <a href="mailto:bellita@naver.com">bellita@naver.com</a>
        <a href="https://github.com/seojungyoun" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </footer>

    <script>
      // 필요한 순간에만 영상 불러오기
      const loadFrames = (root: Element | null) =>
        root?.querySelectorAll<HTMLIFrameElement>("iframe[data-src]").forEach((f) => {
          if (!f.getAttribute("src")) f.setAttribute("src", f.dataset.src ?? "");
        });

      // 대표 작업 슬라이더
      const slides = Array.from(document.querySelectorAll<HTMLElement>(".feature-slide"));
      const sliderTabs = Array.from(document.querySelectorAll<HTMLElement>(".slider-tab"));
      let current = 0;
      function goTo(index: number) {
        const next = (index + slides.length) % slides.length;
        slides[current].classList.remove("is-active");
        sliderTabs[current]?.classList.remove("is-active");
        slides[next].classList.add("is-active");
        sliderTabs[next]?.classList.add("is-active");
        loadFrames(slides[next].querySelector(".media-slide.is-active"));
        current = next;
      }
      sliderTabs.forEach((tab, i) => tab.addEventListener("click", () => goTo(i)));
      document.getElementById("slider-prev")?.addEventListener("click", () => goTo(current - 1));
      document.getElementById("slider-next")?.addEventListener("click", () => goTo(current + 1));

      // 영상 ↔ 도식 슬라이더
      document.querySelectorAll<HTMLElement>("[data-media-slider]").forEach((slider) => {
        const mSlides = Array.from(slider.querySelectorAll<HTMLElement>(".media-slide"));
        const dots = slider.querySelector<HTMLElement>(".media-dots");
        let mCur = 0;
        const goMedia = (i: number) => {
          mSlides[mCur].classList.remove("is-active");
          mCur = (i + mSlides.length) % mSlides.length;
          mSlides[mCur].classList.add("is-active");
          loadFrames(mSlides[mCur]);
          if (dots) dots.textContent = `${mCur + 1} / ${mSlides.length}`;
        };
        slider.querySelector(".media-prev")?.addEventListener("click", () => goMedia(mCur - 1));
        slider.querySelector(".media-next")?.addEventListener("click", () => goMedia(mCur + 1));
      });

      // 기타 작업 탭
      const archiveTabs = Array.from(document.querySelectorAll("[data-archive-tab]"));
      const archivePanels = Array.from(document.querySelectorAll("[data-archive-panel]"));
      archiveTabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const target = tab.getAttribute("data-archive-tab");
          archiveTabs.forEach((t) => {
            t.classList.remove("is-active");
            t.setAttribute("aria-selected", "false");
          });
          tab.classList.add("is-active");
          tab.setAttribute("aria-selected", "true");
          archivePanels.forEach((panel) => {
            const match = panel.getAttribute("data-archive-panel") === target;
            panel.classList.toggle("is-active", match);
            panel.toggleAttribute("hidden", !match);
          });
        });
      });

      // 글라스 카드 반응형 하이라이트
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const hoverPointer = window.matchMedia("(hover: hover) and (pointer: fine)");
      document.querySelectorAll<HTMLElement>(".feature-slider-outer, .management-panel, .archive-card").forEach((surface) => {
        let frame = 0;
        surface.classList.add("glass-reactive");
        surface.addEventListener("pointermove", (event) => {
          if (reducedMotion.matches || !hoverPointer.matches) return;
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(() => {
            const b = surface.getBoundingClientRect();
            surface.style.setProperty("--glow-x", `${event.clientX - b.left}px`);
            surface.style.setProperty("--glow-y", `${event.clientY - b.top}px`);
          });
        });
        surface.addEventListener("pointerleave", () => {
          cancelAnimationFrame(frame);
          surface.style.removeProperty("--glow-x");
          surface.style.removeProperty("--glow-y");
        });
      });

      // 워크플로우 이미지 크게 보기
      const lightbox = document.getElementById("tv-lightbox");
      const lbImg = lightbox?.querySelector("img");
      const lbCap = lightbox?.querySelector("figcaption");
      const openZoom = (el: HTMLElement) => {
        if (!lightbox || !lbImg || !lbCap) return;
        lbImg.setAttribute("src", el.dataset.zoomSrc ?? "");
        lbImg.setAttribute("alt", el.dataset.zoomCaption ?? "");
        lbCap.textContent = el.dataset.zoomCaption ?? "";
        lightbox.hidden = false;
        document.body.style.overflow = "hidden";
      };
      const closeZoom = () => {
        if (!lightbox) return;
        lightbox.hidden = true;
        document.body.style.overflow = "";
      };
      document.querySelectorAll<HTMLElement>(".tv-zoomable").forEach((el) => {
        el.addEventListener("click", () => openZoom(el));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openZoom(el); }
        });
      });
      lightbox?.addEventListener("click", closeZoom);
      document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeZoom(); });

      // 스크롤 등장
      const revealTargets = document.querySelectorAll(
        ".intro-strip, .section-header, .slider-nav, .feature-slider-outer, .management-panel, .archive-shell, .metric-card"
      );
      revealTargets.forEach((el, index) => {
        el.classList.add("reveal");
        (el as HTMLElement).style.setProperty("--reveal-delay", `${(index % 3) * 65}ms`);
      });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.04 });
      revealTargets.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
